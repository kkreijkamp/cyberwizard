{
  "name": "cyberwizard",
  "version": "0.0.0",
  "private": true,
  "description": "Node-based data manipulation workbench — CyberChef operations on a LiteGraph canvas",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
